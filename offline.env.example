# Copy this file to offline.env, or run:
#   powershell -ExecutionPolicy Bypass -File .\deploy\windows\New-OfflineEnv.ps1
#
# Do not commit offline.env. It contains the keys that encrypt local data.

# Compose and image identity
COMPOSE_PROJECT_NAME=paper-tracker-offline
PAPER_TRACKER_IMAGE_TAG=offline
PAPER_TRACKER_DATA_VOLUME=paper-tracker-offline-data

# Backend runtime
OFFLINE_MODE=true
# Keep original paper PDFs inside the service. This blocks both explicit
# downloads and the raw-byte endpoint formerly used by the browser PDF viewer.
PAPER_TRACKER_ALLOW_PDF_EGRESS=false
LITELLM_LOCAL_MODEL_COST_MAP=True
PAPER_TRACKER_DATA_DIR=/app/backend/data
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
DATABASE_URL=sqlite:////app/backend/data/paper_tracker.db
CONTROL_DATABASE_URL=sqlite:////app/backend/data/control/control_plane.db
CHECKPOINT_DB_PATH=/app/backend/data/graph_checkpoints.db
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24

# Required secrets. New-OfflineEnv.ps1 replaces these placeholders.
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEY_FALLBACKS=
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_JWT_SECRET
PAPER_TRACKER_SERVICE_TOKEN=REPLACE_WITH_GENERATED_SERVICE_TOKEN
LLM_CONFIG_ADMIN_TOKEN=REPLACE_WITH_GENERATED_ADMIN_TOKEN

# A fresh volume has no accounts. Leave registration enabled only long enough
# to create the first local account, then set this to 0 and restart.
PAPER_TRACKER_ALLOW_PUBLIC_REGISTRATION=1

# The gateway is bound to loopback. Keep COPILOT_RUNTIME_SECRET empty: the
# browser-visible value is not a security boundary, and same-origin access is
# authenticated by the backend's httpOnly JWT cookie.
COPILOT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
COPILOT_REQUEST_TIMEOUT_MS=300000
COPILOT_RUNTIME_SECRET=

# Local model servers are reached only through a fixed-port proxy. Backend has
# no default external route and must not use localhost/host.docker.internal.
ALLOW_LOCAL_LLM_BASE_URLS=true
ALLOW_LAN_LLM_BASE_URLS=false
OFFLINE_LLM_ALLOWED_HOSTS=model-proxy
OLLAMA_API_BASE=http://model-proxy:11434
VLLM_API_BASE=http://model-proxy:8000/v1
LMSTUDIO_API_BASE=http://model-proxy:1234/v1
LLAMACPP_API_BASE=http://model-proxy:30000/v1

# No cloud provider is seeded or contacted by default.
AUTO_SEED_LLM_CONFIGS=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LLM_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Prevent inherited proxy settings from redirecting internal traffic.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,copilot-runtime,model-proxy
