# Paper Tracker Pro Configuration
#
# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY BEST PRACTICES - 密钥管理安全最佳实践
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. 永远不要提交 .env 文件到版本控制系统
#    - .env 已在 .gitignore 中列出
#    - 使用 .env.example 作为模板（不含真实密钥）
#
# 2. 生成强随机密钥
#    - ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    - JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# 3. 密钥隔离原则
#    - ENCRYPTION_KEY 和 JWT_SECRET_KEY 必须不同 (CWE-321)
#    - 生产环境使用不同的密钥，不与开发/测试环境共享
#
# 4. 密钥轮换策略
#    - ENCRYPTION_KEY 使用版本管理 (ENCRYPTION_KEY_VERSION, ENCRYPTION_KEY_FALLBACKS)
#    - 建议每 90-180 天轮换一次关键密钥
#    - 轮换流程: 见下方 "密钥轮换指南" 章节
#
# 5. 访问控制
#    - 文件权限: chmod 600 .env (仅所有者可读写)
#    - 生产环境使用密钥管理服务 (如 AWS Secrets Manager, HashiCorp Vault)
#    - CI/CD 环境使用机密变量，不要明文传递
#
# ═══════════════════════════════════════════════════════════════════════════════
# 密钥轮换指南 (KEY ROTATION GUIDE)
# ═══════════════════════════════════════════════════════════════════════════════
#
# 加密密钥轮换步骤:
# 1. 生成新密钥: NEW_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# 2. 更新 .env:
#    ENCRYPTION_KEY_VERSION=2
#    ENCRYPTION_KEY=$NEW_KEY
#    ENCRYPTION_KEY_FALLBACKS=<old_key>
# 3. 重启应用 (新数据使用新密钥加密)
# 4. 等待数据自然过渡或运行迁移脚本重新加密所有数据
# 5. 验证无问题后从 FALLBACKS 移除旧密钥
#
# JWT 密钥轮换步骤:
# 1. 生成新密钥: NEW_SECRET=$(python -c "import secrets; print(secrets.token_urlsafe(64))")
# 2. 更新 .env: JWT_SECRET_KEY=$NEW_SECRET
# 3. 重启应用 (所有新 token 使用新密钥)
# 4. 旧 token 会在过期时间(30分钟)后自动失效
# 5. 无需额外迁移操作
#
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3457
DATABASE_URL=sqlite:///./paper_tracker.db
# Optional separate control-plane database path (accounts, sessions and audit).
# Defaults to backend/data/control/control_plane.db when omitted.
# CONTROL_DATABASE_URL=sqlite:///./backend/data/control/control_plane.db
# User-scoped MCP access token issued by POST /api/auth/token.
PAPER_TRACKER_BEARER_TOKEN=
TRACKER_KEYWORDS=llm:2.0,transformer:1.5,retrieval:1.2,multimodal:1.0,agent:0.8

# Offline OCR executable override. If omitted, Paper Tracker checks PATH,
# the bundled app location, and standard Windows Tesseract install paths.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional external tessdata directory; bundled eng/chi_sim/osd resources are preferred.
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
# Maximum time for one PDF metadata request to the enabled project model.
PDF_IMPORT_LLM_TIMEOUT_SECONDS=120

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEY_FALLBACKS=

# JWT Secret — REQUIRED, must be different from ENCRYPTION_KEY (CWE-321).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Multi-account deployments keep self-registration disabled. Accounts are provisioned by managers.
PAPER_TRACKER_ALLOW_PUBLIC_REGISTRATION=0

# Service token is accepted only by the scheduler ingestion endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAPER_TRACKER_SERVICE_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:5002

# CopilotRuntime security
COPILOT_ALLOWED_ORIGINS=http://localhost:3457,http://localhost:5002
# Runtime endpoint defaults to /api/copilotkit so /api-scoped auth cookies
# are sent to the proxy. If changed, mirror it in VITE_COPILOT_RUNTIME_URL.
COPILOT_RUNTIME_ENDPOINT=/api/copilotkit
# Optional shared secret — if set, all Copilot runtime requests must include
# X-Copilot-Secret header with matching value. Leave empty for local dev.
COPILOT_RUNTIME_SECRET=
# Frontend must mirror the secret (VITE_ prefix exposes it to browser)
VITE_COPILOT_RUNTIME_SECRET=

# LLM config admin protection
LLM_CONFIG_ADMIN_TOKEN=
LLM_CONFIG_TRUST_LOOPBACK_ONLY=true

# Default LLM (fallback when no DB config exists)
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# -------- LLM Providers (optional startup seeding) --------
# Disabled by default: model configurations should normally be managed in the UI.
# Set this to true only when you explicitly want the backend to create entries
# from the provider environment variables below during startup.
AUTO_SEED_LLM_CONFIGS=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-chat

# Volcengine / Doubao (火山引擎)
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=
# 支持 "显示名=deployment_id" 的逗号分隔列表，例如:
# ARK_MODEL_IDS=Doubao Seed 2.0 Pro=ep-xxxx,Doubao Seed 2.0 Lite=ep-yyyy
ARK_MODEL_IDS=

# Alibaba DashScope (通义千问)
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODELS=qwen-plus

# OpenAI
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-4-20250514

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Paper Tracker Pro
OPENROUTER_MODELS=google/gemini-2.5-flash

# Moonshot (Kimi)
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_MODELS=moonshot-v1-auto

# ZhipuAI (ChatGLM)
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODELS=glm-4-flash

# xAI (Grok)
XAI_API_KEY=
XAI_MODELS=grok-3-mini-fast

# Local providers (disabled by default for SSRF safety)
ALLOW_LOCAL_LLM_BASE_URLS=false
# Set to true to allow LAN IP addresses (e.g., 192.168.x.x) for local providers
ALLOW_LAN_LLM_BASE_URLS=false
LLM_ALLOWED_REMOTE_HOSTS=
OLLAMA_MODEL=
OLLAMA_MODELS=
OLLAMA_API_KEY=
OLLAMA_API_BASE=http://127.0.0.1:11434
VLLM_MODEL=
VLLM_MODELS=
VLLM_API_KEY=
VLLM_API_BASE=http://127.0.0.1:8000/v1

# llama.cpp (OpenAI-compatible, supports LAN hosts)
LLAMACPP_MODEL=Qwen3-Coder-Next-Q4_K_M.gguf
LLAMACPP_MODELS=
LLAMACPP_API_KEY=
LLAMACPP_API_BASE=http://localhost:30000/v1

# -------- LangGraph Checkpoint --------
CHECKPOINT_DB_PATH=graph_checkpoints.db

# -------- Database Backup --------
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=1

# -------- System Prompt Cache --------
PROMPT_CACHE_TTL=60

# -------- LangSmith (optional) --------
# Enable tracing to monitor LangGraph agent execution in LangSmith dashboard.
# Sign up at https://smith.langchain.com/ to get an API key.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Paper Tracker

# -------- Proxy (optional) --------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
