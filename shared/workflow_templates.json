      "status": "active",
      "execution": {
        "stages": ["normalize", "search", "select", "analysis", "trends", "synthesis"],
        "defaultSelectionCount": 8,
        "synthesisGoal": "生成带有研究脉络、代表性方法、趋势与建议的文献综述。",
        "synthesisInstructions": [
          "报告需包含：研究背景、代表性工作脉络、方法分群、关键趋势、结论。",
          "末尾必须包含 `## 建议` 与 `## 后续问题` 两个二级标题。"
