    {
      "id": "topic",
      "label": "研究主题",
      "type": "text",
      "placeholder": "例如：检索增强生成在科研助手中的应用",
      "required": true
    },
    {
      "id": "timeRange",
      "label": "检索时间范围",
      "type": "select",
      "options": ["近1年", "近3年", "近5年", "全部"],
      "default": "近3年"
    },
    {
      "id": "sources",
      "label": "检索来源",
      "type": "multiselect",
      "options": ["本地论文库"],
      "default": ["本地论文库"]
